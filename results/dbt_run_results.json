he early-warning model (analysis/), with the three strongest drivers.\nselect\n    sha256(concat_ws('||', upper(coalesce(trim(cast(g.golden_company_id as TEXT)), '')), upper(coalesce(trim(cast(r.as_of_date as TEXT)), '')), upper(coalesce(trim(cast(r.model_name as TEXT)), '')))) as risk_score_key,\n    c.company_key,\n    g.golden_company_id as company_id,\n    r.as_of_date,\n    r.model_name,\n    case when r.model_name = 'M2_logit_z_wc' then 1 else 0 end as is_champion,\n    r.probability_12m,\n    r.risk_band,\n    r.top_3_drivers,\n    r.run_id\nfrom \"bilanzwerk\".\"staging\".\"stg_analysis__risk_scores\" as r\ninner join \"bilanzwerk\".\"business_vault\".\"bv_company_golden\" as g\n    on\n        g.company_bk_type = 'CIK'\n        and r.cik = g.cik\nleft join \"bilanzwerk\".\"marts\".\"dim_company\" as c\n    on\n        g.golden_company_id = c.company_id\n        and r.as_of_date >= c.valid_from\n        and r.as_of_date < c.valid_to", "relation_name": "\"bilanzwerk\".\"marts\".\"fact_risk_score\"", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-28T14:14:18.279312Z", "completed_at": "2026-10-28T14:14:18.296259Z"}, {"name": "execute", "started_at": "2026-10-28T14:14:18.317870Z", "completed_at": "2026-10-28T14:14:18.369374Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.09750795364379883, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.bilanzwerk.accepted_values_fact_risk_score_is_champion__False__0__1.60bd4451ab", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        is_champion as value_field,\n        count(*) as n_records\n\n    from \"bilanzwerk\".\"marts\".\"fact_risk_score\"\n    group by is_champion\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    0,1\n)\n\n\n", "relation_name": "\"bilanzwerk\".\"dbt_test__audit\".\"accepted_values_fact_risk_score_is_champion__False__0__1\"", "batch_results":