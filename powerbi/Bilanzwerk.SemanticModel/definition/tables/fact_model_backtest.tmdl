/// Gepoolter Out-of-time-Backtest je Modell (PR-AUC, Recall Top 5 %, Brier).
table fact_model_backtest
	lineageTag: 4c15fa05-5dad-5ae8-ba42-1c053d6c0d2f
	sourceLineageTag: [marts].[fact_model_backtest]

	/// Fläche unter der Precision-Recall-Kurve im gepoolten Out-of-time-Backtest.
	measure 'PR-AUC' = MAX ( fact_model_backtest[pr_auc] )
		formatString: 0.000
		displayFolder: Modellgüte
		lineageTag: 60664f67-cdad-51d4-9819-3c6c98c1c531

	/// Anteil der Insolvenzen unter den 5 % Unternehmen mit dem höchsten Score.
	measure 'Recall Top 5 %' = MAX ( fact_model_backtest[recall_top5] )
		formatString: 0%
		displayFolder: Modellgüte
		lineageTag: 754a7768-f347-5305-9c11-f253621f1ed2

	/// Mittlerer quadratischer Fehler der Wahrscheinlichkeit (kleiner ist besser).
	measure 'Brier Score' = MAX ( fact_model_backtest[brier] )
		formatString: 0.0000
		displayFolder: Modellgüte
		lineageTag: a4cf9d25-e286-5381-a2c1-a5ea3815ce0b

	/// Diagrammtitel: bestes Modell nach PR-AUC und sein Abstand zu Z'' allein (M1), aus den Daten berechnet.
	measure 'Befund Modellgüte' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _best = TOPN ( 1, VALUES ( fact_model_backtest[model_name] ), [PR-AUC], DESC )
			VAR _name = CALCULATE ( SELECTEDVALUE ( fact_model_backtest[model_name] ), _best )
			VAR _bestauc = CALCULATE ( [PR-AUC], _best )
			VAR _m1 = CALCULATE ( [PR-AUC], fact_model_backtest[model_name] = "M1_logit_z" )
			RETURN
			    IF ( ISBLANK ( _bestauc ), BLANK (),
			        IF ( _en,
			            _name & " ranks best: PR-AUC " & FORMAT ( _bestauc, "0.000" ) & " against " & FORMAT ( _m1, "0.000" ) & " for Z'' alone",
			            _name & " trennt am besten: PR-AUC " & FORMAT ( _bestauc, "0.000" ) & " gegen " & FORMAT ( _m1, "0.000" ) & " für Z'' allein" ) )
		displayFolder: Beschriftungen
		lineageTag: 3428a168-fb3e-57e2-8fb8-b70abec8cb20

