/// Die drei Fallstudien (feste Auswahlregel, analysis/pipeline.py).
table fact_case_study
	lineageTag: 3914dc89-6835-5509-9e4b-ac808a25dece
	sourceLineageTag: [marts].[fact_case_study]

	/// Titel der Fallstudie: Unternehmen, Ereignisdatum und Vorlaufzeiten beider Flaggen, aus den Daten.
	measure 'Befund Fallstudie' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _name = SELECTEDVALUE ( fact_case_study[company_name] )
			VAR _datum = SELECTEDVALUE ( fact_case_study[event_date] )
			VAR _z = SELECTEDVALUE ( fact_case_study[lead_months_z] )
			VAR _c = SELECTEDVALUE ( fact_case_study[lead_months_ccc] )
			VAR _zt = IF ( ISBLANK ( _z ), IF ( _en, "never red", "nie rot" ), FORMAT ( _z, "0.0" ) & IF ( _en, " months ahead", " Monate vorher" ) )
			VAR _ct = IF ( ISBLANK ( _c ), IF ( _en, "never red", "nie rot" ), FORMAT ( _c, "0.0" ) & IF ( _en, " months ahead", " Monate vorher" ) )
			RETURN
			    IF ( ISBLANK ( _name ), IF ( _en, "Pick a case study", "Bitte eine Fallstudie wählen" ),
			        _name & IF ( _en, ", bankruptcy ", ", Insolvenz " ) & FORMAT ( _datum, IF ( _en, "yyyy-MM-dd", "dd.MM.yyyy" ) )
			            & " · Z'': " & _zt & " · CCC: " & _ct )
		displayFolder: Beschriftungen
		lineageTag: 8eb1a3f6-9a81-52b4-be41-1a2563c1103c

	column case_rank
		dataType: int64
		formatString: 0
		summarizeBy: none
