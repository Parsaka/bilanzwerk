/// Finanzzeilen je Unternehmen, Periode, Position, Szenario und Version.
table fact_financial_line
	lineageTag: 1a5e4a62-1851-5a0e-86ed-ecc6e0aea6d6
	sourceLineageTag: [marts].[fact_financial_line]

	/// Vorzeichenrichtige Schritte von Umsatz bis EBIT: Umsatz, minus Umsatzkosten, Rest bis EBIT; ohne Schritt das EBIT (Summe des Wasserfalls).
	measure 'GuV-Brücke Betrag' =
			IF (
			    HASONEVALUE ( 'GuV-Brücke'[Reihenfolge] ),
			    SWITCH (
			        VALUES ( 'GuV-Brücke'[Reihenfolge] ),
			        1, [Umsatz],
			        2, - [COGS],
			        3, [EBIT] - ( [Umsatz] - [COGS] )
			    ),
			    [EBIT]
			)
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 49622978-94e3-5ee8-a9a4-b8aa8b3c43fb

	/// Summe in der gewählten Währung (Berechnungsgruppe Währung). Landeswährung nur bei genau einer Währung im Kontext.
	measure '_Betrag Roh' =
			VAR _waehrung = SELECTEDVALUE ( 'Währung'[Währung], "EUR" )
			RETURN
			    IF (
			        _waehrung = "EUR",
			        SUM ( fact_financial_line[amount_eur] ),
			        IF ( HASONEVALUE ( dim_currency[currency_code] ), SUM ( fact_financial_line[amount_local] ) )
			    )
		formatString: #,0
		displayFolder: _Basis
		isHidden
		lineageTag: 700ac674-3e11-5bbc-b7e1-52cf7a608280

	/// Ohne Szenarioauswahl gilt Ist.
	measure '_Betrag Szenario' =
			IF (
			    ISFILTERED ( dim_scenario[scenario_code] ),
			    [_Betrag Roh],
			    CALCULATE ( [_Betrag Roh], dim_scenario[scenario_code] = "IST" )
			)
		formatString: #,0
		displayFolder: _Basis
		isHidden
		lineageTag: 18a72f08-47e0-5717-b304-2a7784dd198d

	/// Basismessung aller Finanzzeilen. Ohne Auswahl gelten Szenario Ist und Version latest (nach Restatements); die Seite Datenqualität vergleicht mit first_reported.
	measure Betrag =
			IF (
			    ISFILTERED ( fact_financial_line[version] ),
			    [_Betrag Szenario],
			    CALCULATE ( [_Betrag Szenario], fact_financial_line[version] = "latest" )
			)
		formatString: #,0
		displayFolder: _Basis
		isHidden
		lineageTag: fd8401f4-842f-557d-b1a3-c058f2fe3f82

	/// Bilanzwert zum letzten Periodenende jedes Unternehmens im Kontext (Stichtagswert, nicht summiert über Quartale).
	measure Bestand =
			SUMX (
			    VALUES ( dim_company[company_id] ),
			    VAR _letzter = CALCULATE ( MAX ( fact_financial_line[period_end_date] ) )
			    RETURN CALCULATE ( [Betrag], dim_date[date_key] = _letzter )
			)
		formatString: #,0
		displayFolder: _Basis
		isHidden
		lineageTag: 506b00bd-f83e-529a-b68a-b469e37ed5ea

	/// Umsatzerlöse (Position REV), Summe der Quartale im Kontext.
	measure Umsatz = CALCULATE ( [Betrag], dim_line_item[line_item_code] = "REV" )
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 85134ba5-84e9-54b1-b43b-30372ecccc31

	/// Umsatzkosten (Position COGS).
	measure COGS = CALCULATE ( [Betrag], dim_line_item[line_item_code] = "COGS" )
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 763108ac-cf6b-5650-bb0c-d646743ed90b

	/// Betriebsergebnis (Position EBIT).
	measure EBIT = CALCULATE ( [Betrag], dim_line_item[line_item_code] = "EBIT" )
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 82c9e066-d59e-56e3-b01d-1f57bdf8c6ae

	/// Jahresergebnis der Anteilseigner (Position NI).
	measure Jahresergebnis = CALCULATE ( [Betrag], dim_line_item[line_item_code] = "NI" )
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 5a11b8ff-2e1f-582f-bf93-c9a5eab03d9a

	/// EBIT geteilt durch Umsatz.
	measure 'EBIT-Marge' = DIVIDE ( [EBIT], [Umsatz] )
		formatString: 0.0%
		displayFolder: GuV
		lineageTag: 1825728d-a19c-5780-b88c-8abe788dff23

	/// (Umsatz minus Umsatzkosten) geteilt durch Umsatz.
	measure Bruttomarge = DIVIDE ( [Umsatz] - [COGS], [Umsatz] )
		formatString: 0.0%
		displayFolder: GuV
		lineageTag: 5fcbd67c-50f4-58db-923b-3ee46648e534

	/// Umsatz der letzten zwölf Monate (Element TTM der Berechnungsgruppe Zeitintelligenz); braucht einen Datumskontext aus dim_date, im Geschäftsjahr-Kontext von dim_period leer.
	measure 'Umsatz TTM' = CALCULATE ( [Umsatz], Zeitintelligenz[Zeit] = "TTM" )
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 7076125f-4631-50b1-b652-674afa7a98db

	/// Umsatzkosten der letzten zwölf Monate; braucht wie Umsatz TTM einen Datumskontext aus dim_date.
	measure 'COGS TTM' = CALCULATE ( [COGS], Zeitintelligenz[Zeit] = "TTM" )
		formatString: #,0,," Mio"
		displayFolder: GuV
		lineageTag: 166c44d8-2f57-5450-969c-8c96ba07c788

	/// Bilanzsumme Aktiva zum Stichtag.
	measure Bilanzsumme = CALCULATE ( [Bestand], dim_line_item[line_item_code] = "TA" )
		formatString: #,0,," Mio"
		displayFolder: Bilanz
		lineageTag: 45594c39-0d84-5ad7-bbb3-60e49a8b73b3

	/// Eigenkapital gesamt zum Stichtag.
	measure Eigenkapital = CALCULATE ( [Bestand], dim_line_item[line_item_code] = "EQ" )
		formatString: #,0,," Mio"
		displayFolder: Bilanz
		lineageTag: ebec05e1-da02-5117-b68c-b4f87f44d7c6

	/// Verbindlichkeiten gesamt zum Stichtag.
	measure Verbindlichkeiten = CALCULATE ( [Bestand], dim_line_item[line_item_code] = "TL" )
		formatString: #,0,," Mio"
		displayFolder: Bilanz
		lineageTag: 8011fa11-3d8b-50d5-ba40-6bc765c6c5b2

	/// Eigenkapital geteilt durch Bilanzsumme.
	measure Eigenkapitalquote = DIVIDE ( [Eigenkapital], [Bilanzsumme] )
		formatString: 0.0%
		displayFolder: Bilanz
		lineageTag: b1c9fbfe-bfed-5616-98a3-eae8f42222aa

	/// Verbindlichkeiten geteilt durch Eigenkapital.
	measure Verschuldungsgrad = DIVIDE ( [Verbindlichkeiten], [Eigenkapital] )
		formatString: 0.00
		displayFolder: Bilanz
		lineageTag: 20df2f75-2f66-5b74-9003-e28c6b683d4d

	/// Liquide Mittel zum Stichtag.
	measure 'Liquide Mittel' = CALCULATE ( [Bestand], dim_line_item[line_item_code] = "CASH" )
		formatString: #,0,," Mio"
		displayFolder: Bilanz
		lineageTag: d1c920e1-fa68-5891-80ec-a22dab02dc47

	/// Cashflow aus laufender Geschäftstätigkeit.
	measure 'Operativer Cashflow' = CALCULATE ( [Betrag], dim_line_item[line_item_code] = "CFO" )
		formatString: #,0,," Mio"
		displayFolder: Cashflow
		lineageTag: d753b705-b01f-59b0-abf0-77c85f5d9990

	/// Operativer Cashflow geteilt durch EBIT.
	measure 'Cash Conversion (CFO / EBIT)' = DIVIDE ( [Operativer Cashflow], [EBIT] )
		formatString: 0.0%
		displayFolder: Cashflow
		lineageTag: 149f3d02-ff85-5413-9645-170adccd25f7

	/// Durchschnitt der Forderungen aus Lieferungen und Leistungen über die Perioden im Kontext.
	measure 'Forderungen Durchschnitt' =
			AVERAGEX (
			    VALUES ( dim_period[period_key] ),
			    CALCULATE ( [Betrag], dim_line_item[line_item_code] = "AR" )
			)
		formatString: #,0,," Mio"
		displayFolder: Working Capital
		lineageTag: e30aaaec-1e63-5148-ba21-9b75a176b239

	/// Durchschnitt der Vorräte.
	measure 'Vorräte Durchschnitt' =
			AVERAGEX (
			    VALUES ( dim_period[period_key] ),
			    CALCULATE ( [Betrag], dim_line_item[line_item_code] = "INV" )
			)
		formatString: #,0,," Mio"
		displayFolder: Working Capital
		lineageTag: d051dcc3-8c78-5d22-bf42-22bdfadd4158

	/// Durchschnitt der Verbindlichkeiten aus Lieferungen und Leistungen.
	measure 'Verbindlichkeiten LuL Durchschnitt' =
			AVERAGEX (
			    VALUES ( dim_period[period_key] ),
			    CALCULATE ( [Betrag], dim_line_item[line_item_code] = "AP" )
			)
		formatString: #,0,," Mio"
		displayFolder: Working Capital
		lineageTag: 8869d3e1-c584-5346-bf34-af66c9cbd319

	/// Days Sales Outstanding aus fact_kpi (dbt: Forderungen / Umsatz TTM * 365, Point-in-time je Periode), letzte Version.
	measure DSO = CALCULATE ( [KPI Wert], dim_kpi[kpi_code] = "DSO" )
		formatString: 0.0
		displayFolder: Working Capital
		lineageTag: 4250bc30-2a96-502b-a01b-0e789fc058c0

	/// Days Inventory Outstanding aus fact_kpi (dbt: Vorräte / COGS TTM * 365), letzte Version.
	measure DIO = CALCULATE ( [KPI Wert], dim_kpi[kpi_code] = "DIO" )
		formatString: 0.0
		displayFolder: Working Capital
		lineageTag: 64bb7d1b-8a22-5ebf-9090-2cb8d69b4785

	/// Days Payables Outstanding aus fact_kpi (dbt: Verbindlichkeiten LuL / COGS TTM * 365), letzte Version.
	measure DPO = CALCULATE ( [KPI Wert], dim_kpi[kpi_code] = "DPO" )
		formatString: 0.0
		displayFolder: Working Capital
		lineageTag: 8e7f040f-95dc-5b3c-b5bb-1b5e3eeba7f6

	/// Cash Conversion Cycle in Tagen (DSO + DIO - DPO) aus fact_kpi, letzte Version; dieselbe Zahl wie in H1 und der Watchlist.
	measure CCC = CALCULATE ( [KPI Wert], dim_kpi[kpi_code] = "CCC" )
		formatString: 0.0
		displayFolder: Working Capital
		lineageTag: 29e85bc8-58ac-5c3e-af99-5d1282746427

	/// Mittlerer absoluter prozentualer Fehler des Forecasts je Unternehmen und Quartal.
	measure 'Prognosefehler MAPE' =
			AVERAGEX (
			    SUMMARIZE ( fact_financial_line, dim_company[company_key], dim_period[period_key] ),
			    VAR _ist = CALCULATE ( [Umsatz], dim_scenario[scenario_code] = "IST" )
			    VAR _fc = CALCULATE ( [Umsatz], dim_scenario[scenario_code] = "FC" )
			    RETURN IF ( NOT ISBLANK ( _fc ), DIVIDE ( ABS ( _ist - _fc ), ABS ( _ist ) ) )
			)
		formatString: 0.0%
		displayFolder: Plan-Ist
		lineageTag: dde69af8-6f7b-5bbb-887c-2b5b6f37d0d7

	/// Letzter Veröffentlichungszeitpunkt (available_at) aller Werte im Modell, unabhängig von Filtern. Für Fußzeilen und das Excel-Cockpit.
	measure Datenstand = CALCULATE ( MAX ( fact_financial_line[available_at] ), REMOVEFILTERS () )
		formatString: dd.MM.yyyy
		displayFolder: Datenqualität
		lineageTag: 62dec0ef-aba2-5432-8de4-d108326771b4

