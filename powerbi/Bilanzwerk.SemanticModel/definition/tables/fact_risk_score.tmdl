/// Insolvenzwahrscheinlichkeit 12 Monate je Unternehmen, Stichtag und Modell.
table fact_risk_score
	lineageTag: c19198bb-03ab-5305-86e6-5a741a04c2ba
	sourceLineageTag: [marts].[fact_risk_score]

	/// Hintergrundfarbe des Risikobands (rot ab 10 %, gelb ab 3 %, sonst grün; Schwellen wie analysis/config.py). Rot und Grün nur hier.
	measure 'Risiko Farbe' =
			VAR _p = [Risiko 12M]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _p ), BLANK (),
			        _p >= 0.10, "#F4C7C3",
			        _p >= 0.03, "#FCE8B2",
			        "#C8E6C9"
			    )
		displayFolder: Beschriftungen\Farben
		lineageTag: f653b133-9e8d-5cd0-8318-907ab527c5ea

	/// Kopfzeile der Unternehmensseiten: Unternehmen, Insolvenzrisiko 12 Monate und rote Flaggen zum letzten Abschluss, aus den Daten.
	measure 'Befund Unternehmen' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _p = [Risiko 12M]
			VAR _flaggen = COALESCE ( [Rote Flaggen letzter Abschluss], 0 )
			RETURN
			    IF ( NOT HASONEVALUE ( dim_company[company_id] ), [Ausgewähltes Unternehmen],
			        [Ausgewähltes Unternehmen] & " · "
			            & IF ( _en, "12-month bankruptcy risk ", "Insolvenzrisiko 12 Monate " )
			            & IF ( ISBLANK ( _p ), "n/a", FORMAT ( _p, "0.0%" ) )
			            & " · " & FORMAT ( _flaggen, "#,0" ) & IF ( _en, " red flags", " rote Flaggen" ) )
		displayFolder: Beschriftungen
		lineageTag: 0297a492-1b8b-5f8a-9cd5-d444637a2a33

	/// Diagrammtitel: Unternehmen im roten Band zum jeweils letzten Stichtag je Unternehmen (Champion-Modell), aus den Daten berechnet.
	measure 'Befund Frühwarnung' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _n = [Unternehmen rot]
			VAR _stichtag = CALCULATE ( MAX ( fact_risk_score[as_of_date] ), fact_risk_score[is_champion] = 1 )
			RETURN
			    IF ( ISBLANK ( _stichtag ), BLANK (),
			        IF ( _en,
			            FORMAT ( COALESCE ( _n, 0 ), "#,0" ) & " companies in the red band at their latest score (up to " & FORMAT ( _stichtag, "yyyy-MM-dd" ) & ")",
			            FORMAT ( COALESCE ( _n, 0 ), "#,0" ) & " Unternehmen im roten Band zum jeweils letzten Stichtag (bis " & FORMAT ( _stichtag, "dd.MM.yyyy" ) & ")" ) )
		displayFolder: Beschriftungen
		lineageTag: 7a5feb26-ada9-50d3-9197-bc50952f6b04

	/// Durchschnittliche kalibrierte Insolvenzwahrscheinlichkeit in 12 Monaten, Champion-Modell (ADR-007), zum letzten Stichtag je Unternehmen im Kontext (die Stichtage unterscheiden sich je Unternehmen).
	measure 'Risiko 12M' =
			-- no date filter (page 7, company pages): each company's latest score is flagged in dbt
			-- (is_latest_for_company), a plain filter for the storage engine
			-- with a date filter (Veränderung zum Vorquartal): the latest date per company within the
			-- dates in context, as (company, as-of date) pairs; a single latest date across the context
			-- would keep only the few companies scored on exactly that day
			IF (
			    NOT ISFILTERED ( dim_date ),
			    CALCULATE (
			        AVERAGE ( fact_risk_score[probability_12m] ),
			        fact_risk_score[is_champion] = 1,
			        fact_risk_score[is_latest_for_company] = 1
			    ),
			    VAR _letzte =
			        CALCULATETABLE (
			            ADDCOLUMNS ( VALUES ( fact_risk_score[company_id] ), "@stichtag", CALCULATE ( MAX ( fact_risk_score[as_of_date] ) ) ),
			            fact_risk_score[is_champion] = 1
			        )
			    RETURN
			        CALCULATE (
			            AVERAGE ( fact_risk_score[probability_12m] ),
			            TREATAS ( _letzte, fact_risk_score[company_id], fact_risk_score[as_of_date] ),
			            fact_risk_score[is_champion] = 1
			        )
			)
		formatString: 0.0%
		displayFolder: Kreditrisiko
		lineageTag: b562c582-e93b-5404-a5a2-d922cb3c2d2c

	/// Anzahl Unternehmen im roten Risikoband (Champion-Modell, letzter Stichtag je Unternehmen im Kontext).
	measure 'Unternehmen rot' =
			IF (
			    NOT ISFILTERED ( dim_date ),
			    CALCULATE (
			        DISTINCTCOUNT ( fact_risk_score[company_id] ),
			        fact_risk_score[is_champion] = 1,
			        fact_risk_score[is_latest_for_company] = 1,
			        fact_risk_score[risk_band] = "red"
			    ),
			    VAR _letzte =
			        CALCULATETABLE (
			            ADDCOLUMNS ( VALUES ( fact_risk_score[company_id] ), "@stichtag", CALCULATE ( MAX ( fact_risk_score[as_of_date] ) ) ),
			            fact_risk_score[is_champion] = 1
			        )
			    RETURN
			        CALCULATE (
			            DISTINCTCOUNT ( fact_risk_score[company_id] ),
			            TREATAS ( _letzte, fact_risk_score[company_id], fact_risk_score[as_of_date] ),
			            fact_risk_score[is_champion] = 1,
			            fact_risk_score[risk_band] = "red"
			        )
			) + 0
		formatString: #,0
		displayFolder: Kreditrisiko
		lineageTag: 8d9dc8d2-ea49-5347-8b04-e5afa7a2c364

	/// Risiko 12M minus Risiko 12M drei Monate früher.
	measure 'Risiko Veränderung zum Vorquartal' = [Risiko 12M] - CALCULATE ( [Risiko 12M], DATEADD ( dim_date[date_key], -3, MONTH ) )
		formatString: +0.0%;-0.0%
		displayFolder: Kreditrisiko
		lineageTag: 5245682a-6de8-5fe4-a3ae-28d2493a5363

