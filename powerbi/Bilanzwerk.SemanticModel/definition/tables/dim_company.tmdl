/// Golden record je Unternehmen (SCD Typ 2 auf Name und Sektor).
table dim_company
	lineageTag: 60b3252d-f6dc-5108-ae88-9e466e47d995
	sourceLineageTag: [marts].[dim_company]

	/// Anteil der aktuellen Unternehmen mit LEI.
	measure 'LEI-Match-Quote' = DIVIDE ( CALCULATE ( COUNTROWS ( dim_company ), dim_company[is_current] = 1, dim_company[is_lei_matched] = 1 ), CALCULATE ( COUNTROWS ( dim_company ), dim_company[is_current] = 1 ) )
		formatString: 0.0%
		displayFolder: Stammdaten
