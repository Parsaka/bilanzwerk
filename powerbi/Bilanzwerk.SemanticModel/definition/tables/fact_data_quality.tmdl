/// Datenqualitäts-Scorecard je Lauf, Regel und Tabelle.
table fact_data_quality
	lineageTag: 894c6774-dab3-5588-86e9-b79f1115b549
	sourceLineageTag: [marts].[fact_data_quality]

	/// Bestandene Prüfungen geteilt durch geprüfte Zeilen im letzten Lauf.
	measure 'DQ Pass-Rate' =
			VAR _lauf = CALCULATE ( MAX ( fact_data_quality[run_at] ), REMOVEFILTERS ( fact_data_quality ) )
			RETURN
			    CALCULATE (
			        DIVIDE ( SUM ( fact_data_quality[rows_checked] ) - SUM ( fact_data_quality[rows_failed] ), SUM ( fact_data_quality[rows_checked] ) ),
			        fact_data_quality[run_at] = _lauf
			    )
		formatString: 0.0%
		displayFolder: Datenqualität
		lineageTag: d966f9d5-df36-5d71-890f-18c5da527f47

	/// Anzahl Regeln mit Status fail im letzten Lauf.
	measure 'Regeln verletzt' =
			VAR _lauf = CALCULATE ( MAX ( fact_data_quality[run_at] ), REMOVEFILTERS ( fact_data_quality ) )
			RETURN CALCULATE ( COUNTROWS ( fact_data_quality ), fact_data_quality[run_at] = _lauf, fact_data_quality[status] = "fail" )
		formatString: #,0
		displayFolder: Datenqualität
		lineageTag: d91e33ba-a02b-513e-a949-7fc3981b3dc7

	column run_id
		dataType: string
		isHidden
