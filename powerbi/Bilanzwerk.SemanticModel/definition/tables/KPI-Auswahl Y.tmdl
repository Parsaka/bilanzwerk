/// Zweiter Feldparameter für den Peer-Vergleich: die Kennzahl auf der y-Achse des Streudiagramms.
table 'KPI-Auswahl Y'
	lineageTag: 7a91671b-25ef-54d3-9162-e8ae15a4aeca

	/// Wert der in KPI-Auswahl Y gewählten Kennzahl (für die Achsen des Streudiagramms), außerhalb plausibler Grenzen leer.
	measure 'KPI-Auswahl Y Wert' = SWITCH ( SELECTEDVALUE ( 'KPI-Auswahl Y'[KPI-Auswahl Y Reihenfolge] ), 0, VAR _v = [EBIT-Marge] RETURN IF ( _v >= -2 && _v <= 1, _v ), 1, VAR _v = [DSO] RETURN IF ( _v >= 0 && _v <= 730, _v ), 2, VAR _v = [DIO] RETURN IF ( _v >= 0 && _v <= 730, _v ), 3, VAR _v = [DPO] RETURN IF ( _v >= 0 && _v <= 730, _v ), 4, VAR _v = [CCC] RETURN IF ( _v >= -730 && _v <= 730, _v ), 5, VAR _v = [Eigenkapitalquote] RETURN IF ( _v >= -5 && _v <= 1, _v ), 6, VAR _v = [Z'' Score] RETURN IF ( _v >= -20 && _v <= 20, _v ), 7, VAR _v = [Bruttomarge] RETURN IF ( _v >= -2 && _v <= 1, _v ), 8, VAR _v = [Verschuldungsgrad] RETURN IF ( _v >= -50 && _v <= 50, _v ) )
		formatString: #,0.00
		displayFolder: Peer-Vergleich
		lineageTag: 274c0204-e370-5041-9001-8ee435f07012

	/// Sektorperzentil der in KPI-Auswahl Y gewählten Kennzahl (Rang des Werts im Sektor, niedrig = kleiner Wert).
	measure 'KPI-Auswahl Y Perzentil' = SWITCH ( SELECTEDVALUE ( 'KPI-Auswahl Y'[KPI-Auswahl Y Reihenfolge] ), 0, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "EBIT_MARGIN" ), 1, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "DSO" ), 2, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "DIO" ), 3, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "DPO" ), 4, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "CCC" ), 5, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "EQUITY_RATIO" ), 6, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "ZPP" ), 7, CALCULATE ( [Sektorperzentil], dim_kpi[kpi_code] = "GROSS_MARGIN" ) )
		formatString: 0%
		displayFolder: Peer-Vergleich
		lineageTag: 067493d5-6e5b-5d60-805d-18095631f685

