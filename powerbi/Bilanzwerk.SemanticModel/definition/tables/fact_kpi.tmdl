/// Kennzahlen mit Sektorperzentil, Veränderung und roter Flagge.
table fact_kpi
	lineageTag: 9cc15d74-9159-523f-a2ce-0ae943d485dd
	sourceLineageTag: [marts].[fact_kpi]

	/// Median des CCC über alle Unternehmen des Sektors im Kontext (aus fact_kpi, letzte Version).
	measure 'CCC Sektor-Median' =
			CALCULATE (
			    MEDIANX ( VALUES ( dim_company[company_key] ), [KPI Wert] ),
			    REMOVEFILTERS ( dim_company ),
			    VALUES ( dim_sector[sector_key] ),
			    dim_kpi[kpi_code] = "CCC"
			)
		formatString: 0.0
		displayFolder: Working Capital
		lineageTag: 664d9e1f-b41d-5fe9-94e0-d29ec3871af6

	/// Durchschnittlicher Kennzahlenwert im Kontext (letzte Version, nach Restatements).
	measure 'KPI Wert' = CALCULATE ( AVERAGE ( fact_kpi[value] ), fact_kpi[version] = "latest" )
		formatString: 0.00
		displayFolder: Kennzahlen
		lineageTag: 8ad5023c-68c9-54e7-a542-314bed7d1d33

	/// Kennzahlenwert aus den erstveröffentlichten Zahlen (Point-in-time, Grundlage des Modells).
	measure 'KPI Wert erstveröffentlicht' = CALCULATE ( AVERAGE ( fact_kpi[value] ), fact_kpi[version] = "first_reported" )
		formatString: 0.00
		displayFolder: Kennzahlen
		lineageTag: 5672502a-cde8-59bd-96f9-8f5067fd4d95

	/// Perzentil der Kennzahl innerhalb von Sektor und Jahr.
	measure Sektorperzentil = CALCULATE ( AVERAGE ( fact_kpi[sector_percentile] ), fact_kpi[version] = "latest" )
		formatString: 0%
		displayFolder: Kennzahlen
		lineageTag: 58360fe2-56e0-5275-9d8b-6e8a1bf0db90

	/// Anzahl roter Flaggen (Schwelle laut dim_kpi).
	measure 'Rote Flaggen' = CALCULATE ( SUM ( fact_kpi[red_flag] ), fact_kpi[version] = "latest" )
		formatString: #,0
		displayFolder: Kennzahlen
		lineageTag: a8e6c125-aaa7-575e-8054-6d36f918793d

	/// Altman Z'' (1995) für Nicht-Produzenten. Unter 1,1 Distress-Zone, über 2,6 sichere Zone.
	measure 'Z'''' Score' = CALCULATE ( [KPI Wert], dim_kpi[kpi_code] = "ZPP" )
		formatString: 0.00
		displayFolder: Kreditrisiko
		lineageTag: f2371b39-df62-51cb-9731-3232d3e510ec

	/// Anteil der Kennzahlenwerte (letzte Version), die um mehr als 0,5 % von der Erstveröffentlichung abweichen.
	measure 'Restatement-Quote' =
			-- fact_kpi[is_restated] is set in dbt on both rows of a pair (latest differs from first
			-- reported by more than 0.5 %), so the measure is a filtered count in the storage engine
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_kpi ), fact_kpi[version] = "latest", fact_kpi[is_restated] = 1 ),
			    CALCULATE ( COUNTROWS ( fact_kpi ), fact_kpi[version] = "latest" )
			)
		formatString: 0.0%
		displayFolder: Datenqualität
		lineageTag: 1649e910-f3a5-5cc8-95c2-401a8397f82a

