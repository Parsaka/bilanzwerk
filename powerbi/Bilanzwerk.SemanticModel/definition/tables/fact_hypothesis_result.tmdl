/// H1–H4, wie der letzte Modelllauf sie entschieden hat (analysis/answer.json).
table fact_hypothesis_result
	lineageTag: 34f7f263-379b-5b16-90e9-1647ecdc24fd
	sourceLineageTag: [marts].[fact_hypothesis_result]

	/// Ergebnissatz der Hypothese in der Zeile (Tabelle auf der Seite Antwort), Deutsch oder Englisch.
	measure 'Antwort Text' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			RETURN IF ( _en, SELECTEDVALUE ( fact_hypothesis_result[text_en] ), SELECTEDVALUE ( fact_hypothesis_result[text_de] ) )
		displayFolder: Beschriftungen\Antwort
		lineageTag: 51f78bb4-f967-5eee-b62a-4304a6ea08e6

	/// Ergebnissatz zu H1 Vorlaufzeit aus dem letzten Modelllauf (Deutsch oder Englisch nach Sprache), nie von Hand.
	measure 'Antwort H1' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _de = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_de] ), fact_hypothesis_result[hypothesis_code] = "H1" )
			VAR _txt = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_en] ), fact_hypothesis_result[hypothesis_code] = "H1" )
			RETURN IF ( _en, _txt, _de )
		displayFolder: Beschriftungen\Antwort
		lineageTag: 5c16b2f9-02cd-52cc-b484-ffeb20bc039b

	/// Ergebnissatz zu H2 Genauigkeit aus dem letzten Modelllauf (Deutsch oder Englisch nach Sprache), nie von Hand.
	measure 'Antwort H2' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _de = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_de] ), fact_hypothesis_result[hypothesis_code] = "H2" )
			VAR _txt = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_en] ), fact_hypothesis_result[hypothesis_code] = "H2" )
			RETURN IF ( _en, _txt, _de )
		displayFolder: Beschriftungen\Antwort
		lineageTag: 3c86e763-7788-53c1-99e4-dbcb71d173b9

	/// Ergebnissatz zu H3 Sektorsicht aus dem letzten Modelllauf (Deutsch oder Englisch nach Sprache), nie von Hand.
	measure 'Antwort H3' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _de = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_de] ), fact_hypothesis_result[hypothesis_code] = "H3" )
			VAR _txt = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_en] ), fact_hypothesis_result[hypothesis_code] = "H3" )
			RETURN IF ( _en, _txt, _de )
		displayFolder: Beschriftungen\Antwort
		lineageTag: 6d82587b-71c5-55e8-bd2a-bbc94a200b49

	/// Ergebnissatz zu H4 Euro-Wert aus dem letzten Modelllauf (Deutsch oder Englisch nach Sprache), nie von Hand.
	measure 'Antwort H4' =
			VAR _en = SELECTEDVALUE ( Sprache[Code], "DE" ) = "EN"
			VAR _de = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_de] ), fact_hypothesis_result[hypothesis_code] = "H4" )
			VAR _txt = CALCULATE ( SELECTEDVALUE ( fact_hypothesis_result[text_en] ), fact_hypothesis_result[hypothesis_code] = "H4" )
			RETURN IF ( _en, _txt, _de )
		displayFolder: Beschriftungen\Antwort
		lineageTag: 5ac6ceaf-6022-5e0d-804d-03e20fe5ecee

	/// Anzahl der Hypothesen H1–H4, die der letzte Lauf bestätigt hat.
	measure 'Hypothesen bestätigt' = SUM ( fact_hypothesis_result[is_held] )
		formatString: #,0
		displayFolder: Antwort
		lineageTag: 897551ff-4d54-533f-8b59-5d643871e71c

